# Copy to server/.env  (server/.env is gitignored — never commit real keys)

# Port the Express API listens on. The Vite UI proxies /api here.
PORT=3001

# SQLite file. Relative paths resolve from the project root.
DB_PATH=data/hireloop.db

# --- LLM (Phase 2) ---
# Free keys: Gemini → https://aistudio.google.com/apikey   Groq → https://console.groq.com/keys
# OpenAI is PAID (needs credits at https://platform.openai.com/settings/organization/billing); used last.
# Write them without quotes and without a leading "#".
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional (defaults shown). Check your keys: npm run llm:check -w server   (add `-- --call` for one live test call each)
# LLM_ORDER=gemini,groq,openai,ollama
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_RPM=10
# GROQ_RPM=20
# OPENAI_RPM=30
# LLM_DAILY_BUDGET=300
# LLM_TIMEOUT_MS=30000
# Ollama (local, optional; off unless OLLAMA_MODEL is set)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# --- Added in later phases ---
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
